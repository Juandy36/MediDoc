# Copia este archivo a .env y rellénalo. .env NUNCA se sube a git.
# En Vercel, configura estas mismas variables en el proyecto del backend.

# Neon: URL con pooler (runtime) y URL directa (migraciones). Usa la rama "dev" en local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Origen público del frontend (p. ej. http://localhost:3000 o https://medidoc.vercel.app)
APP_ORIGIN=

# Correos con acceso inicial de administrador, separados por comas
ADMIN_EMAILS=

# Google OAuth (Google Cloud Console). Redirect URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave AES-256 para cifrar campos sensibles: 32 bytes en base64.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes, los datos cifrados son irrecuperables: guárdala en un gestor de contraseñas.
FIELD_ENCRYPTION_KEY=

# Cloudflare R2 (bucket privado)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
